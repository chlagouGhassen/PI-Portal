DATABASE_URL="postgresql://pi_portal:pi_portal_dev@localhost:5432/pi_portal?schema=public"

# 32+ chars en dev, 64+ chars en prod (généré avec `openssl rand -hex 32` ou équivalent)
JWT_SECRET="change-me-in-production-use-a-long-random-string"

PORT=4000
NODE_ENV=development

# DOIT être true en production (HTTPS requis pour transmettre le cookie)
COOKIE_SECURE=false

# SameSite du cookie. 'lax' = défaut sûr same-origin. 'none' = nécessaire pour
# cross-origin (frontend Vercel + backend Render par exemple), EXIGE COOKIE_SECURE=true.
COOKIE_SAMESITE=lax

# En prod : URL absolue du frontend (ex. https://portail.exemple.com)
CORS_ORIGIN=http://localhost:5173

# Nombre de reverse proxies devant l'app. 0 en local, généralement 1 derrière nginx/Cloud Run.
# Critique pour que express-rate-limit voie la VRAIE IP du client (sinon tout vient de 127.0.0.1).
TRUST_PROXY=0
